{
  "name": "kong-konnect",
  "version": "1.0.0",
  "description": "Portable Kong Konnect skills plus remote MCP configuration for Claude Code.",
  "author": {
    "name": "kong"
  },
  "skills": [
    "./skills/deck-gateway",
    "./skills/gateway-plugin-datakit",
    "./skills/kong-skill-authoring",
    "./skills/kongctl-declarative",
    "./skills/kongctl-query",
    "./skills/konnect-access-scope",
    "./skills/konnect-ai-gateway",
    "./skills/konnect-api-catalog",
    "./skills/konnect-api-publish",
    "./skills/konnect-app-auth",
    "./skills/konnect-control-plane-bootstrap",
    "./skills/konnect-event-gateway",
    "./skills/konnect-gateway-triage",
    "./skills/konnect-observability-triage",
    "./skills/konnect-platform-router",
    "./skills/portal-branding",
    "./skills/portal-page-design",
    "./skills/technical-writing",
    "./skills/terraform-kong-gateway",
    "./skills/terraform-konnect"
  ],
  "userConfig": {
    "konnect_token": {
      "type": "string",
      "title": "Konnect access token",
      "description": "Personal or system account access token used by the Konnect MCP server.",
      "sensitive": true,
      "required": true
    },
    "konnect_mcp_url": {
      "type": "string",
      "title": "Konnect MCP URL",
      "description": "Regional MCP endpoint for your Konnect organization.",
      "default": "https://us.mcp.konghq.com"
    }
  },
  "mcpServers": {
    "kong-konnect": {
      "type": "http",
      "url": "${user_config.konnect_mcp_url}",
      "headers": {
        "Authorization": "Bearer ${user_config.konnect_token}"
      }
    }
  }
}
